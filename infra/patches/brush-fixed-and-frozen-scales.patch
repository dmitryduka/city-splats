index 6a6b70d..6bcd640 100644
--- a/crates/brush-render/src/gaussian_splats.rs
+++ b/crates/brush-render/src/gaussian_splats.rs
@@ -213,6 +213,16 @@ impl Splats {
         self
     }
 
+    /// Give every splat the same isotropic scale (see `TrainConfig::fixed_scale`).
+    pub fn with_uniform_scale(mut self, scale: f32) -> Self {
+        let transforms = self.transforms.val();
+        let n = transforms.dims()[0];
+        let log_scales = Tensor::full([n, 3], scale.ln(), &transforms.device());
+        let transforms = transforms.slice_assign(s![.., 7..10], log_scales);
+        self.transforms = trainable_param(self.transforms.id, transforms);
+        self
+    }
+
     /// Attach a per-splat world-space scale floor (see [`Splats::min_scale`]).
     /// `f` must be `[num_splats]`. Training-only; cleared by refine and never
     /// serialized.
